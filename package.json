{
    "name": "neosidekick-workspace-review",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "packageManager": "yarn@4.10.3",
    "workspaces": [
        "Resources/Private/JavaScript/*"
    ],
    "scripts": {
        "build": "yarn workspace @neosidekick/workspace-review-module run build",
        "watch": "yarn workspace @neosidekick/workspace-review-module run watch",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"Resources/Private/JavaScript/*/src/**/*.spec.ts\"",
        "format": "prettier --write \"Resources/Private/JavaScript/**/*.{ts,tsx,css,json}\""
    },
    "dependencies": {
        "@neosidekick/workspace-review-module": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    },
    "prettier": {
        "printWidth": 120,
        "semi": true,
        "singleQuote": true,
        "tabWidth": 4
    }
}
